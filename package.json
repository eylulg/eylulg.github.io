{
    "name": "eylulg.github.io",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "knip": "knip",
        "size": "size-limit",
        "relink": "rm -rf node_modules/@eylulg/ui && npm install ../ui --install-links",
        "prepare": "husky"
    },
    "dependencies": {
        "@eylulg/ui": "file:../ui",
        "@tailwindcss/vite": "^4.3.3",
        "lucide-react": "^1.71.0",
        "react": "^19.3.0",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.3.0",
        "react-router": "^7.18.5",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.65.0",
        "@size-limit/file": "^14.3.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.0",
        "knip": "^6.44.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "size-limit": "^14.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^7.3.8",
        "vitest": "^3.2.7",
        "vitest-axe": "^0.1.0"
    },
    "description": "Portfolio site of Eylül Güneş, Senior Frontend Developer.",
    "license": "MIT",
    "engines": {
        "node": ">=24"
    }
}
